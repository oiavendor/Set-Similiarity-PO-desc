; Settings of the OpenAI clients built in utils/GenAI.py.
;
; Any value can be overridden at runtime with an environment variable:
;   [llm]        base_url -> OPENAI_BASE_URL, api_key -> OPENAI_API_KEY, model -> OPENAI_MODEL
;   [embedding]  base_url -> OPENAI_EMBEDDING_BASE_URL, api_key -> OPENAI_API_KEY, model -> OPENAI_EMBEDDING_MODEL
;
; base_url must point at the root that serves /responses and /embeddings
; (e.g. https://api.openai.com/v1 for OpenAI, or http://<host>:<port>/v1 for a
; self-hosted OpenAI-compatible server such as vLLM, Ollama or LM Studio).
; timeout is in seconds and max_retries is how often the client retries a failed request.

[llm]
base_url = https://ai-know.nus.edu.sg/backend/completions/oai
api_key = abc123
default_headers = {"Ocp-Apim-Subscription-Key": "xxx"}
model = gpt-5.5
temperature = 0
max_output_tokens = 2048
timeout = 120
max_retries = 2

; provider decides where description_matching gets its vectors from:
;   api   -> the OpenAI-compatible endpoint configured in this section
;   local -> a sentence-transformers model run on this machine, see [embedding.local]
; The language model still adjudicates every cluster either way; this only changes
; which candidate groups it is asked about.
[embedding]
provider = api
base_url = http://airts-ml:42828/v1
api_key = EMPTY
model = text-embedding-3-small
timeout = 120
max_retries = 2

; Used only when provider = local. model takes any sentence-transformers id; the three
; carrying thresholds below are:
;   all-MiniLM-L6-v2           384 dims, 256 token limit, ~90MB, fastest
;   all-mpnet-base-v2          768 dims, 384 token limit, ~420MB, stronger, ~3x slower
;   Qwen/Qwen3-Embedding-0.6B  1024 dims, long context, ~1.2GB, strongest, slow on CPU
; Descriptions longer than a model's token limit are silently truncated.
; device blank picks CUDA when available and falls back to CPU.
; Set local_files_only = true on a machine that cannot reach huggingface.co, after
; pre-downloading the weights into the HuggingFace cache.
[embedding.local]
model = all-MiniLM-L6-v2
batch_size = 256
device =
normalize = true
trust_remote_code = false
local_files_only = false

; Agglomerative clustering joins two descriptions when their cosine DISTANCE is below
; the value for the embedding model in use. Lower means stricter, so fewer and tighter
; clusters. These are per model because every model has its own distance distribution:
; reusing another model's number is the fastest way to silently over- or under-cluster.
;
; WARNING: only text-embedding-3-small is calibrated against real data. The local values
; below are seeded from a five-description smoke test, NOT from labelled data. Calibrate
; them before relying on a run that uses them.
;
; Measured cosine distances on that smoke test, for reference:
;                             near-duplicate   differing quantity   unrelated
;   all-MiniLM-L6-v2               0.039             0.079            0.838
;   all-mpnet-base-v2              0.010             0.040            0.901
;   Qwen/Qwen3-Embedding-0.6B      0.000             0.023            0.407
;
; Note how narrow Qwen's usable band is: unrelated items sit at 0.407, less than half the
; distance the other two put them at, so its thresholds have far less headroom.
; Note also that a quantity change ("box of 100" vs "box of 200") reads as near-identical
; to every one of these models. Thresholds sit above those values on purpose, so such a
; pair reaches the language model rather than being silently dropped before it.

[threshold.po]
text-embedding-3-small = 0.20
all-MiniLM-L6-v2 = 0.25
all-mpnet-base-v2 = 0.25
Qwen/Qwen3-Embedding-0.6B = 0.20

[threshold.payment]
text-embedding-3-small = 0.05
all-MiniLM-L6-v2 = 0.12
all-mpnet-base-v2 = 0.10
Qwen/Qwen3-Embedding-0.6B = 0.06
