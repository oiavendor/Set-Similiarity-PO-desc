; Configuration for the OpenAI-compatible LLM endpoints used by utils/GenAI.py.
;
; Any value can be overridden at runtime with an environment variable:
;   [llm]        base_url -> OPENAI_BASE_URL, api_key -> OPENAI_API_KEY, model -> OPENAI_MODEL
;   [embedding]  base_url -> OPENAI_EMBEDDING_BASE_URL, api_key -> OPENAI_API_KEY, model -> OPENAI_EMBEDDING_MODEL
;
; base_url must point at the root that serves /chat/completions and /embeddings
; (e.g. https://api.openai.com/v1 for OpenAI, or http://<host>:<port>/v1 for a
; self-hosted OpenAI-compatible server such as vLLM, Ollama or LM Studio).

[llm]
base_url = http://airts-ml:42829/v1
api_key = EMPTY
model = gpt-4o-mini
temperature = 0
max_tokens = 1024
timeout = 120

[embedding]
base_url = http://airts-ml:42828/v1
api_key = EMPTY
model = text-embedding-3-small
timeout = 120
