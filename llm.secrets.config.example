; Template for llm.secrets.config. Copy this file to llm.secrets.config and fill in the
; real values there:
;     cp llm.secrets.config.example llm.secrets.config
;
; llm.secrets.config is gitignored and is the ONLY place credentials belong. It is layered
; over llm.config at load time, so anything set here overrides the matching option there and
; llm.config stays safe to commit. Every option is optional: whatever you leave out keeps
; the value llm.config gave it.
;
; Precedence, lowest to highest:  llm.config  ->  llm.secrets.config  ->  environment variable
;
; Do not add comments on the same line as a value. configparser keeps the text that follows
; a value, so 'api_key = abc123  ; my key' would send the comment as part of the key.

[llm]
; The API key for the gateway named by base_url in llm.config.
api_key = REPLACE_ME

; The whole default_headers value is replaced, so keep it valid JSON on one line.
default_headers = {"Ocp-Apim-Subscription-Key": "REPLACE_ME"}

[embedding]
; Only needed when [embedding] provider = api. The default provider is local, which uses
; no credentials at all.
api_key = REPLACE_ME
