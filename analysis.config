; Which columns each analysis in description_matching.py reads and writes.
;
; This file describes WHAT THE ANALYSES DO - which columns they read and write, and how
; strictly they cluster. How to reach and run a model - endpoints, keys, provider,
; model names - lives in llm.config.
;
; One section per analysis type, named exactly as the analysis_type argument passed to
; description_matching (currently 'po' and 'payment').
;
;   group_column        already in the source data; rows are clustered within each group
;   description_column  already in the source data; the text that gets embedded
;   boolean_column      written back; created empty when the source data lacks it
;   explanation_column  written back; created empty when the source data lacks it
;   default             the verdict for a row in a group that did not land in a cluster, and the
;                       verdict every still empty row is filled with at the end of the run.
;                       Split on the first comma into the boolean and the explanation, so it
;                       needs exactly one leading comma.
;
; Renaming a column here is all that is needed to point an analysis at differently named
; source data; nothing in the Python holds these names.
;
; These three are optional. Leaving them out gives an analysis the behaviour it had before line
; matching existed:
;
;   match_mode          'blob' embeds each row's whole description as one vector, 'line' splits
;                       it into line items and matches those. See the line matching notes below.
;   line_separator      what the line items of one row are joined by. Only read in line mode.
;   pair_score          which line mode score decides two rows belong together, 'containment'
;                       or 'jaccard'. See the line matching notes below.
;
; Do not put a comment on the same line as a value: configparser keeps the comment text
; as part of the value.

[po]
group_column = Unique_Group_Number
description_column = Line_desc
boolean_column = Is Split PO
explanation_column = Explanation
default = No,Item descriptions are different and are not from a split PO
match_mode = line
line_separator = ||
pair_score = containment

[payment]
group_column = Set
description_column = Item Text
boolean_column = Is Duplicate Payment
explanation_column = Explanation
default = No,Item descriptions are different and are not for duplicate payment
match_mode = blob

; How strict each analysis clusters. Agglomerative clustering joins two descriptions when
; their cosine DISTANCE is below
; the value for the embedding model in use. Lower means stricter, so fewer and tighter
; clusters. These are per model because every model has its own distance distribution:
; reusing another model's number is the fastest way to silently over- or under-cluster.
;
; WARNING: only text-embedding-3-small is calibrated against real data. The local values
; below are seeded from a five-description smoke test, NOT from labelled data. Calibrate
; them before relying on a run that uses them.
;
; Measured cosine distances on that smoke test, for reference:
;                             near-duplicate   differing quantity   unrelated
;   all-MiniLM-L6-v2               0.039             0.079            0.838
;   all-mpnet-base-v2              0.010             0.040            0.901
;   Qwen/Qwen3-Embedding-0.6B      0.000             0.023            0.407
;
; Note how narrow Qwen's usable band is: unrelated items sit at 0.407, less than half the
; distance the other two put them at, so its thresholds have far less headroom.
; Note also that a quantity change ("box of 100" vs "box of 200") reads as near-identical
; to every one of these models. Thresholds sit above those values on purpose, so such a
; pair reaches the language model rather than being silently dropped before it.

[threshold.po]
text-embedding-3-small = 0.20
all-MiniLM-L6-v2 = 0.25
all-mpnet-base-v2 = 0.25
Qwen/Qwen3-Embedding-0.6B = 0.20

[threshold.payment]
text-embedding-3-small = 0.05
all-MiniLM-L6-v2 = 0.12
all-mpnet-base-v2 = 0.10
Qwen/Qwen3-Embedding-0.6B = 0.06


; ---------------------------------------------------------------------------------------------
; Line matching, used when an analysis sets match_mode = line.
;
; A row here is one purchase order, and its description column holds every line item of that PO
; joined by line_separator. Blob mode embeds that joined string as one vector, which makes a PO's
; vector the centroid of its line items, and that centroid loses the thing we are looking for:
; the line items a pair of POs do NOT share drag the score down, and a PO's vector drifts toward
; generic text as it gets longer, so the score ends up partly a function of line count. An 11 line
; PO compared against a 3 line PO is penalised for the size gap alone.
;
; Line mode compares the line items directly and only then aggregates, so an unmatched line can
; no longer damage a matched line's score.
;
; !! DIRECTION FLIP !! The [threshold.*] sections above are cosine DISTANCE, where lower is
; stricter. The two sections below are SIMILARITY and coverage, where HIGHER is stricter. They are
; mirror images, similarity = 1 - distance, so a number copied between them means the opposite of
; what it did. Copying 0.25 down here would ask for a 25% match rather than a 75% one.
;
;   line_threshold      how close two individual line items must be to count as the same item.
;   pair_threshold      how much of one PO's line items must be found in another's before the two
;                       are put in the same cluster. Read against whichever score pair_score
;                       names:
;                         containment - the larger of the two directions, so a small PO wholly
;                                       absorbed into a larger one scores high. This is the split
;                                       PO signature and is the default.
;                         jaccard     - symmetric overlap. Stricter on uneven pairs, because it
;                                       charges the size gap against the score.
;
; Both scores are weighted by how rare each line item is across the whole run. A line every PO
; carries cannot tell you which POs belong together, so it contributes nothing. This matters
; because the sets these analyses read come from an upstream rule that over-fires, often on
; vendor, so the POs in a set tend to share that vendor's fee and freight lines; matching on those
; would re-glue exactly the POs the analysis is meant to separate.
;
; WARNING: none of the numbers below are calibrated. They are seeded as 1 - the blob distance
; above, which is the right DIRECTION but not a transferred calibration: those numbers were tuned
; on whole joined descriptions, and single line items have a different distribution. Calibrate
; against labelled pairs before relying on a line mode run.

[line_threshold.po]
text-embedding-3-small = 0.80
all-MiniLM-L6-v2 = 0.75
all-mpnet-base-v2 = 0.75
Qwen/Qwen3-Embedding-0.6B = 0.80

[line_threshold.payment]
text-embedding-3-small = 0.95
all-MiniLM-L6-v2 = 0.88
all-mpnet-base-v2 = 0.90
Qwen/Qwen3-Embedding-0.6B = 0.94

; How much of the smaller PO has to be accounted for. Uncalibrated: 0.60 says a PO clusters when
; roughly two thirds of what it buys, by rarity weight, also appears on the other PO.

[pair_threshold.po]
text-embedding-3-small = 0.60
all-MiniLM-L6-v2 = 0.60
all-mpnet-base-v2 = 0.60
Qwen/Qwen3-Embedding-0.6B = 0.60

[pair_threshold.payment]
text-embedding-3-small = 0.80
all-MiniLM-L6-v2 = 0.80
all-mpnet-base-v2 = 0.80
Qwen/Qwen3-Embedding-0.6B = 0.80
